# ----- ai-dev-kit (machine-specific) -----
# Skills (.claude/skills, .cursor/skills) ARE committed - they travel with the repo.
# These are local-only: .mcp.json hardcodes this machine's runtime path, and
# .ai-dev-kit/ is installer state. Regenerate on a new machine by re-running the
# ai-dev-kit installer.
.mcp.json
.ai-dev-kit/
install.ps1

